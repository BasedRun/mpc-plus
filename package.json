{
  "name": "mpc-plus",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkc918/mpc-plus.git"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run docs#dev",
    "docs:dev": "vp run docs#dev",
    "docs:check": "vp run docs#types:check && vp run docs#lint",
    "docs:build": "vp run docs#build",
    "publish:packages": "node ./scripts/publish.ts"
  },
  "devDependencies": {
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
