{
  "name": "mpc-plus",
  "version": "0.0.1-alpha.2",
  "private": true,
  "homepage": "https://github.com/pkc918/mpc-plus#readme",
  "bugs": {
    "url": "https://github.com/pkc918/mpc-plus/issues"
  },
  "author": {
    "name": "pkc918",
    "email": "xiaopan2000918@gmail.com",
    "url": "https://github.com/pkc918"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkc918/mpc-plus.git"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && vp check && vp test",
    "dev": "vp run docs#dev",
    "docs:dev": "vp run docs#dev",
    "docs:check": "vp run docs#types:check && vp run docs#lint",
    "docs:build": "vp run docs#build",
    "publish:packages": "node ./scripts/publish.ts"
  },
  "devDependencies": {
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "*",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
